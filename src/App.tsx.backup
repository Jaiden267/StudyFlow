            {/* Trust indicators */}
            <div className="sf-hero-badges flex items-center gap-5 flex-wrap">
              {[
                { icon: Icons.check, text: 'No credit card required' },
                { icon: Icons.sparkle, text: 'Free student plan' },
                { icon: Icons.zap, text: 'Set up in minutes' },
