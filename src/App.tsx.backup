                }}
              >
                Study smarter.
              </span>
            </h1>

            {/* Supporting text */}
            <p
              style={{
                fontSize: '1.0625rem',
                color: 'var(--color-text-secondary)',
                lineHeight: 1.7,
                maxWidth: '460px',
