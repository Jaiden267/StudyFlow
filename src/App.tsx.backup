              }}
            >
              {/* Icon */}
              <div
                className="w-11 h-11 rounded-[var(--radius-md)] flex items-center justify-center shrink-0"
                style={{ background: p.accentLight, color: p.accent }}
              >
                <svg
                  width="20"
