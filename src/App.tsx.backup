                    lineHeight: 1.65,
                  }}
                >
                  {p.description}
                </p>
              </div>

              {/* Accent rule */}
              <div
                className="mt-auto h-0.5 rounded-full w-10"
                style={{ background: p.accent, opacity: 0.5 }}
              />
            </div>
          ))}
        </div>
